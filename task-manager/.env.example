# Copy this file to .env before running:  copy .env.example .env
DB_ROOT_PASSWORD=rootpass
DB_NAME=taskdb
DB_USER=taskuser
DB_PASSWORD=taskpass

# Secret key for signing JWT (change to a long random string)
JWT_SECRET=change-me-to-a-long-random-string

# Default admin account (backend creates it automatically if missing)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin1234
