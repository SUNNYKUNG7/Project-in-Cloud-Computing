# คัดลอกไฟล์นี้เป็น .env ก่อนรัน:  cp .env.example .env
# (.env ไม่ถูก push ขึ้น git — แต่ละคนตั้งค่าเองได้)

DB_ROOT_PASSWORD=rootpass
DB_NAME=taskdb
DB_USER=taskuser
DB_PASSWORD=taskpass

# กุญแจสำหรับเซ็น JWT (เปลี่ยนเป็นข้อความยาว ๆ สุ่ม ๆ)
JWT_SECRET=change-me-to-a-long-random-string

# บัญชี Admin เริ่มต้น — backend จะสร้างให้อัตโนมัติถ้ายังไม่มี
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin1234

# จำกัด CPU ของ backend แต่ละเครื่อง (web1, web2) ให้เห็นเพดานตอน load test
BACKEND_CPUS=0.25
